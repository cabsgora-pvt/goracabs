# ============================================
# Root .gitignore for Gora Cabs Project
# ============================================

# ============================================
# Exclude Specific Folders
# ============================================
driver_envato/
gora_cabs/
.claude/

# ============================================
# Node.js / Next.js (goraadmin)
# ============================================
node_modules/
.next/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.pnpm-debug.log*
.npm
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity
.env*.local
.vercel
*.tsbuildinfo
next-env.d.ts

# ============================================
# PHP / Laravel (gora_cabs)
# ============================================
vendor/
.phpunit.cache
.phpunit.result.cache
auth.json
Homestead.json
Homestead.yaml
/public/hot
/public/build
/public/storage
/storage/*.key

# ============================================
# Flutter / Dart (gora_user, gora_driver, driver_envato)
# ============================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
app.*.symbols
app.*.map.json
/android/app/debug
/android/app/profile
/android/app/release
*.iml
pubspec.lock
.metadata
android/local.properties
android/gradlew
android/gradlew.bat
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
linux/flutter/
macos/Flutter/
windows/flutter/

# ============================================
# Environment & Configuration Files
# ============================================
.env
.env.backup
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local

# ============================================
# IDEs and Editors
# ============================================
.vscode/
.idea/
.fleet/
*.iml
*.ipr
*.iws
.atom/
*.swp
*.swo
*~

# ============================================
# Operating System Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================
# Logs and Temporary Files
# ============================================
*.log
*.pid
*.seed
*.pid.lock
logs/
pids/
lib-cov/
.grunt
.lock-wscript
.nyc_output
.history
.svn/

# ============================================
# Build Outputs
# ============================================
dist/
tmp/
temp/
out/

# ============================================
# Miscellaneous
# ============================================
*.class
*.pyc
migrate_working_dir/
.buildlog/
.swiftpm/

# ============================================
# KEEP: Public and Upload Folders
# ============================================
# Public folders and uploads are NOT ignored
# !public/
# !**/uploads/
